// Схема БД «Долина знаний». Документация: docs/PRODUCT.md, docs/ARCHITECTURE.md
// После изменений: npm run db:push (dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TUTOR
  STUDENT
  ADMIN
}

enum RoomMemberRole {
  TUTOR
  STUDENT
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  REVIEWED
}

enum TaskAnswerType {
  TEXT
  CHOICE
  IMAGE
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         Boolean   @default(false)
  name                  String    @default("")
  image                 String?
  role                  UserRole  @default(STUDENT)
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ownedRooms       Room[]            @relation("RoomOwner")
  roomMemberships  RoomMember[]
  submissions      Submission[]
  marketplaceTasks MarketplaceTask[] @relation("TaskAuthor")
  taskTopics       TaskTopic[]
  bankTasks        Task[]              @relation("TaskTutor")
  roomTopics       RoomTopic[]
  accounts         Account[]
  sessions         Session[]
  profile          UserProfile?
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserProfile {
  userId       String   @id
  displayName  String
  phone        String?
  city         String?
  timeZone     String?
  gradeLevel   String?
  learningGoal String?
  subjects     String[] @default([])
  experience   String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User         @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     RoomMember[]
  assignments Assignment[]
  topics      RoomTopic[]
}

model RoomMember {
  id       String         @id @default(cuid())
  roomId   String
  userId   String
  role     RoomMemberRole @default(STUDENT)
  joinedAt DateTime       @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Assignment {
  id          String           @id @default(cuid())
  roomId      String
  title       String
  content     String
  status      AssignmentStatus @default(DRAFT)
  dueAt       DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sourceTaskId String?

  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  status       SubmissionStatus @default(PENDING)
  feedback     String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model MarketplaceTask {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  description String
  content     String
  subject     String?
  gradeLevel  String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Cascade)
}

model TaskTopic {
  id            String    @id @default(cuid())
  tutorId       String
  title         String
  description   String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  tags          String[]  @default([])
  legacyTopicId Int?      @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tutor User   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([tutorId, sortOrder])
  @@index([isPublished])
}

model Task {
  id                      String         @id @default(cuid())
  topicId                 String
  tutorId                 String
  title                   String
  description             String?
  answerType              TaskAnswerType @default(TEXT)
  correctAnswer           String?
  hint                    String?
  imageUrl                String?
  sortOrder               Int            @default(0)
  supportsMultipleAnswers Boolean        @default(false)
  isActive                Boolean        @default(true)
  legacyTaskId            Int?           @unique
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  topic              TaskTopic               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  tutor              User                    @relation("TaskTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  alternativeAnswers TaskAlternativeAnswer[]
  choiceOptions      TaskChoiceOption[]

  @@index([topicId, sortOrder])
  @@index([tutorId])
}

model TaskAlternativeAnswer {
  id          String   @id @default(cuid())
  taskId      String
  answerText  String
  explanation String?
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskChoiceOption {
  id        String  @id @default(cuid())
  taskId    String
  text      String
  isCorrect Boolean @default(false)
  sortOrder Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model RoomTopic {
  id            String   @id @default(cuid())
  roomId        String
  tutorId       String
  sourceTopicId String?
  title         String
  description   String?
  tags          String[] @default([])
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  room  Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tutor User       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tasks RoomTask[]

  @@index([roomId, sortOrder])
}

model RoomTask {
  id                      String         @id @default(cuid())
  roomTopicId             String
  title                   String
  description             String?
  answerType              TaskAnswerType @default(TEXT)
  correctAnswer           String?
  hint                    String?
  imageUrl                String?
  sortOrder               Int            @default(0)
  supportsMultipleAnswers Boolean        @default(false)
  createdAt               DateTime       @default(now())

  roomTopic          RoomTopic                   @relation(fields: [roomTopicId], references: [id], onDelete: Cascade)
  alternativeAnswers RoomTaskAlternativeAnswer[]
  choiceOptions      RoomTaskChoiceOption[]

  @@index([roomTopicId, sortOrder])
}

model RoomTaskAlternativeAnswer {
  id          String   @id @default(cuid())
  roomTaskId  String
  answerText  String
  explanation String?
  createdAt   DateTime @default(now())

  roomTask RoomTask @relation(fields: [roomTaskId], references: [id], onDelete: Cascade)

  @@index([roomTaskId])
}

model RoomTaskChoiceOption {
  id         String  @id @default(cuid())
  roomTaskId String
  text       String
  isCorrect  Boolean @default(false)
  sortOrder  Int     @default(0)

  roomTask RoomTask @relation(fields: [roomTaskId], references: [id], onDelete: Cascade)

  @@index([roomTaskId, sortOrder])
}
